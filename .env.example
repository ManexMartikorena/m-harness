# Copiar a .env y rellenar. .env no entra en git (docs/PUESTA_EN_MARCHA.md §2).
# maha no lee este fichero: en desarrollo, uv run --env-file .env maha

# Clave de OpenCode Go o Zen (consola de opencode.ai). Desde el hito 2.
OPENCODE_API_KEY=

# Opcional: clave de la API de Anthropic (Claude Console,
# platform.claude.com/settings/keys), para provider = "anthropic". Desde el
# hito 9. No hace falta para usar Claude por OpenCode.
# ANTHROPIC_API_KEY=
